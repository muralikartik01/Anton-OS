{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Program Gold Table Lineage Config",
  "description": "Schema for Program lineage JSON generated by the lineage-extraction skill. Hierarchical structure grouped by market with comprehensive metadata.",
  "type": "object",
  "required": ["lineage_metadata", "markets"],
  "properties": {
    "lineage_metadata": {
      "type": "object",
      "required": ["version", "created_date", "description", "project", "project_full_name"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Schema version (e.g., '2.1')"
        },
        "created_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Creation date YYYY-MM-DD"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of lineage scope"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Project short code (e.g., 'Program-Sub1', 'Program-Sub2')"
        },
        "project_full_name": {
          "type": "string",
          "minLength": 1,
          "description": "Full project name (e.g., 'Your Program Full Name - Example SubProject')"
        },
        "source_type_legend": {
          "type": "object",
          "description": "Source type classification rules"
        },
        "generated_from": {
          "type": "string",
          "description": "Generator tool/skill name"
        },
        "registry_generated_at": {
          "type": "string",
          "description": "ISO timestamp of generation"
        }
      }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["market_code", "market_name", "business_unit_name", "business_unit_key", "gold_tables"],
        "properties": {
          "market_code": {
            "type": "string",
            "minLength": 1,
            "description": "Market short code (US, MX, Global, PBCA, etc.)"
          },
          "market_name": {
            "type": "string",
            "minLength": 1,
            "description": "Market full name (US - United States, MX - Mexico, etc.)"
          },
          "business_unit_name": {
            "type": "string",
            "minLength": 1,
            "description": "Business unit / sector name (BU1, BU2, BU3, Global, etc.)"
          },
          "business_unit_key": {
            "type": "string",
            "minLength": 1,
            "description": "Business unit key (typically same as business_unit_name)"
          },
          "gold_tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "gold_table_name",
                "gold_table_full_name",
                "pipeline_name",
                "sector_name",
                "market_name",
                "load_type",
                "workflow_name",
                "notebook_path",
                "schedule",
                "module",
                "table_type",
                "dq_config",
                "SourceSystemId",
                "ReportingUnitId",
                "Sources"
              ],
              "properties": {
                "gold_table_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Table name only (lowercase)"
                },
                "gold_table_full_name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^{env}_[\\w]+_\\d+\\.[\\w]+\\.[\\w]+$",
                  "description": "Fully qualified 3-part name (catalog.schema.table)"
                },
                "pipeline_name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^PL_",
                  "description": "Pipeline name starting with PL_"
                },
                "sector_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Sector name (BU1, BU2, BU3, BU4, etc.)"
                },
                "market_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Market name (US, MX, Global, etc.)"
                },
                "load_type": {
                  "type": "string",
                  "enum": ["upsert", "append", "overwrite_partition", "overwrite", "scd2", "delete_insert", "parquet_overwrite"],
                  "description": "Data load strategy"
                },
                "workflow_name": {
                  "type": "string",
                  "description": "Databricks workflow name (may be empty string for manual pipelines)"
                },
                "notebook_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Databricks notebook path starting with /Workspace/"
                },
                "schedule": {
                  "type": "object",
                  "required": ["frequency", "day", "hour", "minute"],
                  "properties": {
                    "frequency": {
                      "type": "string",
                      "description": "D=Daily, W=Weekly, M=Monthly, FP=FinancialPeriod, FILEWATCH"
                    },
                    "day": {
                      "type": "string",
                      "description": "Day name or date or empty string"
                    },
                    "hour": {
                      "type": "string",
                      "description": "Hour (0-23) or empty string"
                    },
                    "minute": {
                      "type": "string",
                      "description": "Minute (0-59) or empty string"
                    }
                  }
                },
                "module": {
                  "type": "string",
                  "description": "Business module/domain (Master Data, Transport, Topline, Opex, etc.)"
                },
                "table_type": {
                  "type": "string",
                  "enum": ["Dimension", "Fact", "Reference"],
                  "description": "Table classification"
                },
                "dq_config": {
                  "type": "object",
                  "required": ["dq_flag"],
                  "properties": {
                    "dq_flag": {
                      "type": "string",
                      "enum": ["Y", "N"],
                      "description": "DQ enabled flag"
                    },
                    "dq_subject_area": {
                      "type": "string",
                      "description": "DQ subject area (optional)"
                    },
                    "dq_category": {
                      "type": "string",
                      "description": "DQ category (optional)"
                    },
                    "dq_subcategory": {
                      "type": "string",
                      "description": "DQ subcategory (optional)"
                    },
                    "dq_dataset_layer": {
                      "type": "string",
                      "description": "DQ dataset layer (GOLD, SILVER, etc.)"
                    },
                    "dq_dataset_name": {
                      "type": "string",
                      "description": "Blocking DQ dataset name"
                    },
                    "dq_dataset_unique_keys": {
                      "type": "string",
                      "description": "Unique key columns for DQ (optional)"
                    }
                  }
                },
                "SourceSystemId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Target table system ID (can be comma-separated list or 'N/A')"
                },
                "ReportingUnitId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Target table reporting unit ID (can be comma-separated list or 'N/A')"
                },
                "Sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["Source_Table_Type"],
                    "properties": {
                      "Source_Table_Type": {
                        "type": "string",
                        "enum": ["Silver", "Gold", "Bronze", "Parquet", "Reference"],
                        "description": "Source layer classification"
                      },
                      "Table_Name": {
                        "type": "string",
                        "description": "Fully qualified 3-part table name (for Unity Catalog sources)"
                      },
                      "Table_ShortName": {
                        "type": "string",
                        "description": "Table name only (for Unity Catalog sources)"
                      },
                      "Catalog": {
                        "type": "string",
                        "description": "Catalog name (for Unity Catalog sources)"
                      },
                      "Schema": {
                        "type": "string",
                        "description": "Schema name (for Unity Catalog sources)"
                      },
                      "Source_Path": {
                        "type": "string",
                        "description": "ADLS path for Parquet sources (abfss://...)"
                      },
                      "SourceSystemId": {
                        "type": "string",
                        "description": "Source system ID or 'N/A'"
                      },
                      "ReportingUnitId": {
                        "type": "string",
                        "description": "Source reporting unit ID or 'N/A'"
                      },
                      "Filters_Used": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Array of filter conditions applied to this source"
                      },
                      "Join_Type": {
                        "type": "string",
                        "description": "Join type (LEFT JOIN, INNER JOIN, etc.) or 'N/A'"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "system_id_reference": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "system_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["SourceSystemId", "ReportingUnitId", "description"],
            "properties": {
              "SourceSystemId": {
                "type": "string",
                "minLength": 1
              },
              "ReportingUnitId": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
