# Export in the shell that launches Claude Code. Never commit real values; never paste the password in chat.
export DB_KIT_PG_HOST=your-server.postgres.database.azure.com
export DB_KIT_PG_DATABASE=your-database
export DB_KIT_PG_USER=your-user          # on Azure single-server this may need the form user@server
export DB_KIT_PG_PASSWORD=your-password
# optional: DB_KIT_PG_PORT (default 5432), DB_KIT_PG_SSLMODE (default require)
